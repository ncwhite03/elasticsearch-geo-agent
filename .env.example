WEBUI_SECRET_KEY=replace-with-a-long-random-string

# Any OpenAI-compatible LLM endpoint that supports tool calling (or configure connections in the UI instead)
OPENAI_API_BASE_URL=
OPENAI_API_KEY=

# Fallback Elasticsearch connection for the tool (prefer setting the tool's Valves in the UI).
# Inside docker compose, the dev Elasticsearch is at http://elasticsearch:9200
ES_URL=http://elasticsearch:9200
ES_API_KEY=
ES_USERNAME=
ES_PASSWORD=
